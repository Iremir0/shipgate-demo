{
  "$schema": "https://raw.githubusercontent.com/Iremir0/shipgate/main/schema/pipeline.schema.json",
  "tracker": { "type": "github", "github": { "labelPrefix": "status:" } },
  "keyPattern": "#{n}",
  "commands": {
    "install": "npm ci",
    "quick": ["npm run typecheck", "npm test"],
    "build": [],
    "suites": []
  },
  "verifyOnStop": [
    { "paths": "^(src|tests)/.*\\.ts$", "run": ["npm run typecheck", "npm test"] }
  ],
  "risk": {
    "paths": ["src/pricing/**"],
    "keywords": ["discount", "vat", "rounding"]
  },
  "models": { "devStandard": "sonnet", "devCritical": "opus", "reviewerFor": { "sonnet": "opus", "opus": "sonnet" } },
  "parallel": 2,
  "loopLimit": 3,
  "autoMerge": true,
  "baseBranch": "main",
  "worktreeDir": ".claude/worktrees"
}
